      "value": {
        "schemaVersion": "idp.workspace.app/v1",
        "name": "orders",
        "version": "1.2.0",
        "title": "Orders",
        "description": "Order desk: holds, reviews and approvals.",
        "publisher": "IDP Parcel",
        "entry": {
          "url": "https://orders.apps.example/workspace"
        },
        "capabilities": [
          "context.read",
          "context.write",
          "actions.invoke",
          "inbox.read",
          "ui.notify",
          "identity.token"
        ],
        "actions": [
          {
            "name": "order.review",
            "title": "Ask the order assistant",
            "input": {
              "type": "object",
              "required": [
                "message"
              ],
              "properties": {
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "additionalProperties": false
            },
            "target": {
              "kind": "host.run",
              "agent": "order-assistant"
            }
          },
          {
            "name": "approval.approve",
            "title": "Approve",
            "input": {
              "type": "object",
              "properties": {
                "executionId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "target": {
              "kind": "eer.decision",
              "decision": "approve"
            },
            "roles": [
              "approver"
            ],
            "confirm": true
          },
          {
            "name": "approval.reject",
            "title": "Reject",
            "input": {
              "type": "object",
              "properties": {
                "executionId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "target": {
              "kind": "eer.decision",
              "decision": "reject"
            },
            "roles": [
              "approver"
            ],
            "confirm": true
          },
          {
            "name": "order.hold",
            "title": "Put an order on hold",
            "input": {
              "type": "object",
              "required": [
                "orderId",
                "reason"
              ],
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "reason": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "additionalProperties": false
            },
            "target": {
              "kind": "webhook",
              "url": "https://orders.apps.example/hooks/hold"
            }
          }
        ],
        "config": {
          "schema": {
            "type": "object",
            "required": [
              "region"
            ],
            "properties": {
              "region": {
                "enum": [
                  "us",
                  "eu"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
